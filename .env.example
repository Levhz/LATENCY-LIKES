BOT_TOKEN=your_bot_token
GUILD_ID=123456789012345678
ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432
ADMIN_IDS=111111111111111111
ADMIN_TOKEN=change_this_long_password
API_KEY=change_this_api_key
DEFAULT_REGION=IND
DAY_TZ=Asia/Kolkata
COST_PER_CMD=10
COST_PER_LIKE=0
DAILY_LIMIT=100
MAX_AMOUNT=100
WELCOME_CREDITS=0
POOL_TARGET=8
POOL_MIN=2
POOL_CREATE_CONCURRENCY=2
ACCOUNT_DAILY_CAP=100
ACCOUNT_MAX_FAILS=3
LIKE_GAP=0.35
CMD_COOLDOWN=5
DATA_DIR=./data
# engine: najmi (default) or ffapi (legacy built-in chain)
GUEST_ENGINE=najmi
NAJMI_NAME_PREFIX=LatencyZ
NAJMI_USE_TOR=1
# override Tor completely, e.g. socks5h://user:pass@host:1080
NAJMI_PROXY=
NAJMI_TOR_TIMEOUT=90
NAJMI_READY_TIMEOUT=120
REG_GAP=3
# ffapi-only tuning
GUEST_MIN_GAP_MS=9000
GUEST_MAX_GAP_MS=18000
GUEST_MAX_RETRIES=6
GUEST_BACKOFF_MS=20000
GUEST_MAX_BACKOFF_MS=240000
GUEST_STORM_THRESHOLD=3
GUEST_STORM_COOLDOWN_MS=300000
ROUTE_RETRY_DELAY_MS=15000
GUEST_PROXY_FILE=proxies.txt
